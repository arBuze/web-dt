// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum IndustrialProtocol {
  OPC_UA
  MQTT
}

enum ParameterDataType {
  BOOLEAN
  INT32
  INT64
  FLOAT
  DOUBLE
  STRING
  JSON
}

// ======================================================
// DIGITAL TWIN COMPONENT
// ======================================================

model Component {
  id String @id @default(uuid()) @db.Uuid

  /// Стабильный программный идентификатор:
  /// machine-01, line-01, robot-01
  key String @unique @db.VarChar(100)

  name String @db.VarChar(255)

  /// machine, robot, conveyor, production_line и т.д.
  type String @db.VarChar(100)

  description String?

  isActive Boolean @default(true)

  /// Дополнительные свойства компонента,
  /// специфичные для конкретного оборудования.
  metadata Json?

  /// Информация для 2D/3D визуализации:
  /// координаты, rotation, modelUrl и т.п.
  visualization Json?

  // Иерархия компонентов.
  parentId String? @db.Uuid

  parent Component? @relation("ComponentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children Component[] @relation("ComponentHierarchy")

  parameters Parameter[]

  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  kpiConfig KpiConfig?

  @@index([parentId])
  @@index([type])
  @@map("components")
}

// ======================================================
// DIGITAL TWIN PARAMETER
// ======================================================

model Parameter {
  id String @id @default(uuid()) @db.Uuid

  componentId String @db.Uuid

  /// temperature, speed, state, load...
  key String @db.VarChar(100)

  /// Отображаемое имя
  name String @db.VarChar(255)

  description String?

  dataType ParameterDataType

  unit String? @db.VarChar(50)

  readable Boolean @default(true)
  writable Boolean @default(false)

  /// Допустимые границы.
  /// Позже могут использоваться для validation/alarm detection.
  minValue Float?
  maxValue Float?

  isActive Boolean @default(true)

  metadata Json?

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  bindings ParameterBinding[]

  telemetry TelemetryReading[]

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  controlCommands ControlCommand[]
  alarms          Alarm[]
  alarmRules      AlarmRule[]

  kpiStateConfigs      KpiConfig[] @relation("KpiStateParameter")
  kpiTotalCountConfigs KpiConfig[] @relation("KpiTotalCountParameter")
  kpiGoodCountConfigs  KpiConfig[] @relation("KpiGoodCountParameter")

  /// У одного Component не может быть двух temperature.
  @@unique([componentId, key])
  @@index([componentId])
  @@map("parameters")
}

// ======================================================
// INDUSTRIAL DATA SOURCE
// ======================================================

model DataSource {
  id String @id @default(uuid()) @db.Uuid

  /// plant-simulation-opcua
  /// factory-mqtt
  key String @unique @db.VarChar(100)

  name String @db.VarChar(255)

  protocol IndustrialProtocol

  /// OPC UA:
  /// opc.tcp://127.0.0.1:4840
  ///
  /// MQTT:
  /// mqtt://127.0.0.1:1883
  endpoint String @db.VarChar(500)

  enabled Boolean @default(true)

  /// Дополнительные настройки подключения.
  ///
  /// Например:
  /// {
  ///   "securityMode": "None",
  ///   "clientId": "digital-twin-backend"
  /// }
  config Json?

  /// Здесь НЕ храним пароль.
  /// Это может быть имя переменной окружения / secret.
  credentialsRef String? @db.VarChar(255)

  bindings ParameterBinding[]

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  controlCommands ControlCommand[]

  @@index([protocol])
  @@map("data_sources")
}

// ======================================================
// PARAMETER <-> INDUSTRIAL PROTOCOL MAPPING
// ======================================================

model ParameterBinding {
  id String @id @default(uuid()) @db.Uuid

  parameterId  String @db.Uuid
  dataSourceId String @db.Uuid

  /// OPC UA:
  /// ns=2;s=Machine01.Temperature
  ///
  /// MQTT:
  /// factory/machine01/temperature
  address String @db.VarChar(1000)

  /// Если команда управления отправляется
  /// по другому адресу/topic.
  writeAddress String? @db.VarChar(1000)

  /// Например, если MQTT содержит:
  /// {
  ///   "temperature": 75,
  ///   "speed": 100
  /// }
  ///
  /// selector может быть "temperature".
  selector String? @db.VarChar(255)

  enabled Boolean @default(true)

  /// Для OPC UA polling/subscription.
  samplingIntervalMs Int?

  /// Порог изменения.
  deadband Float?

  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  telemetry TelemetryReading[]

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  controlCommands ControlCommand[]

  @@unique([parameterId, dataSourceId, address])
  @@index([parameterId])
  @@index([dataSourceId])
  @@map("parameter_bindings")
}

// ======================================================
// TIME SERIES DATA
// ======================================================

model TelemetryReading {
  /// id сам по себе НЕ является PK,
  /// потому что TimescaleDB требует включать
  /// timestamp в UNIQUE / PRIMARY KEY.
  id String @default(uuid()) @db.Uuid

  timestamp DateTime @db.Timestamptz(6)

  /// Когда backend фактически получил сообщение.
  receivedAt DateTime @default(now()) @db.Timestamptz(6)

  parameterId String @db.Uuid

  /// Binding оставляем nullable:
  /// исторические данные не должны исчезать,
  /// если конфигурация подключения была удалена.
  bindingId String? @db.Uuid

  protocol IndustrialProtocol

  sourceAddress String? @db.VarChar(1000)

  /// Храним значения типизированно.
  numberValue  Float?
  booleanValue Boolean?
  stringValue  String?

  /// Исходное значение или сложная JSON-структура.
  rawValue Json?

  /// OPC UA StatusCode или результат validation.
  quality String? @db.VarChar(100)

  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  binding ParameterBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)

  /// В TimescaleDB primary key обязан включать
  /// partitioning column timestamp.
  @@id([id, timestamp])
  /// Самый частый запрос:
  /// история конкретного параметра за период.
  @@index([parameterId, timestamp(sort: Desc)])
  @@index([bindingId, timestamp(sort: Desc)])
  @@map("telemetry_readings")
}

enum ControlCommandStatus {
  REQUESTED
  SUCCESS
  FAILED
  REJECTED
}

model ControlCommand {
  id String @id @default(uuid()) @db.Uuid

  requestedAt DateTime  @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  componentKey String @db.VarChar(100)
  parameterKey String @db.VarChar(100)

  parameterId  String? @db.Uuid
  dataSourceId String? @db.Uuid
  bindingId    String? @db.Uuid

  dataSourceKey String? @db.VarChar(100)

  protocol IndustrialProtocol?

  /// boolean / number / string
  requestedValue Json

  status ControlCommandStatus @default(REQUESTED)

  resultStatus String? @db.VarChar(100)

  errorCode    String? @db.VarChar(100)
  errorMessage String?

  parameter Parameter? @relation(fields: [parameterId], references: [id], onDelete: SetNull)

  dataSource DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  binding ParameterBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)

  @@index([requestedAt(sort: Desc)])
  @@index([componentKey, parameterKey, requestedAt(sort: Desc)])
  @@index([status])
  @@map("control_commands")
}

enum AlarmSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlarmCondition {
  ABOVE
  BELOW
}

enum AlarmStatus {
  ACTIVE
  CLEARED
}

model Alarm {
  id String @id @default(uuid()) @db.Uuid

  ruleId      String @db.Uuid
  parameterId String @db.Uuid

  status AlarmStatus @default(ACTIVE)

  startedAt DateTime  @default(now()) @db.Timestamptz(6)
  clearedAt DateTime? @db.Timestamptz(6)

  triggerValue Float
  clearValue   Float?

  /// Снимки значений на момент возникновения
  severity AlarmSeverity
  message  String        @db.VarChar(500)

  rule AlarmRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([ruleId, status])
  @@index([startedAt(sort: Desc)])
  @@map("alarms")
}

model AlarmRule {
  id String @id @default(uuid()) @db.Uuid

  key String @unique @db.VarChar(100)

  name String @db.VarChar(255)

  parameterId String @db.Uuid

  condition AlarmCondition

  /// Порог срабатывания
  threshold Float

  /// Порог снятия тревоги
  clearThreshold Float?

  severity AlarmSeverity

  message String @db.VarChar(500)

  enabled Boolean @default(true)

  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  alarms Alarm[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([parameterId])
  @@map("alarm_rules")
}

model KpiConfig {
  id String @id @default(uuid()) @db.Uuid

  componentId String @unique @db.Uuid

  stateParameterId      String @db.Uuid
  totalCountParameterId String @db.Uuid
  goodCountParameterId  String @db.Uuid

  /// Какое строковое значение означает работу оборудования
  runningStateValue String @default("RUNNING") @db.VarChar(100)

  /// Идеальное время изготовления одной единицы продукции
  idealCycleTimeSeconds Float

  enabled Boolean @default(true)

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  stateParameter Parameter @relation("KpiStateParameter", fields: [stateParameterId], references: [id], onDelete: Restrict)

  totalCountParameter Parameter @relation("KpiTotalCountParameter", fields: [totalCountParameterId], references: [id], onDelete: Restrict)

  goodCountParameter Parameter @relation("KpiGoodCountParameter", fields: [goodCountParameterId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("kpi_configs")
}
